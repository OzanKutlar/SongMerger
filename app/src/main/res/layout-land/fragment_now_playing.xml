<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape player: record on the left, actions + text and controls on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true">

    <me.Integer.Mediaplayer.ui.widgets.CoverAmbienceView
        android:id="@+id/playerAmbience"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.42">

            <me.Integer.Mediaplayer.ui.widgets.VinylDiscView
                android:id="@+id/playerVinyl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_margin="16dp"
                android:clickable="true"
                android:contentDescription="@string/player_cover"
                android:focusable="true" />

            <FrameLayout
                android:id="@+id/playerClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/player_close"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_down"
                    android:tint="#ECEFF1" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.58"
            android:clipChildren="false"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="8dp">

                <FrameLayout
                    android:id="@+id/playerFavorite"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/player_cell_bg"
                    android:clickable="true"
                    android:contentDescription="@string/player_favorite"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/playerFavoriteIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/player_ic_heart_outline"
                        android:tint="#ECEFF1" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/playerQueue"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/player_cell_bg"
                    android:clickable="true"
                    android:contentDescription="@string/player_queue"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/playerQueueIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/player_ic_queue"
                        android:tint="#ECEFF1" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/playerMore"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/player_cell_bg"
                    android:clickable="true"
                    android:contentDescription="@string/menu_more"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/playerMoreIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/player_ic_more"
                        android:tint="#ECEFF1" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <include
                    layout="@layout/player_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
