<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape player: record (or inline queue) on the left; title, actions and controls on the right -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true">

    <me.Integer.Mediaplayer.ui.widgets.CoverAmbienceView
        android:id="@+id/playerAmbience"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.46">

            <FrameLayout
                android:id="@+id/playerDiscStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <me.Integer.Mediaplayer.ui.widgets.VinylDiscView
                    android:id="@+id/playerVinyl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="20dp"
                    android:clickable="true"
                    android:contentDescription="@string/player_cover"
                    android:focusable="true" />
            </FrameLayout>

            <!-- Inline queue view that replaces the vinyl disc in place -->
            <LinearLayout
                android:id="@+id/playerQueueStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:orientation="vertical"
                android:paddingTop="56dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/queueHeader"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/queueSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/queueSavePlaylist"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/player_cell_bg"
                        android:clickable="true"
                        android:contentDescription="@string/queue_save_playlist"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/player_ic_add"
                            android:tint="#ECEFF1" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/queueMore"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/player_cell_bg"
                        android:clickable="true"
                        android:contentDescription="@string/queue_select"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/player_ic_select_all"
                            android:tint="#ECEFF1" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/queueSelectionBar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/queueSelectionClose"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/player_cell_bg"
                        android:clickable="true"
                        android:contentDescription="@string/queue_selection_close"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/player_ic_close"
                            android:tint="#F5F5F7" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/queueSelectionCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:id="@+id/queueSelectAll"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/player_cell_bg"
                        android:clickable="true"
                        android:contentDescription="@string/queue_select_all"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/player_ic_select_all"
                            android:tint="#ECEFF1" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/queueSelectionPlaylist"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/player_cell_bg"
                        android:clickable="true"
                        android:contentDescription="@string/menu_add_playlist"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/player_ic_add"
                            android:tint="#ECEFF1" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/queueSelectionFavorite"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/player_cell_bg"
                        android:clickable="true"
                        android:contentDescription="@string/menu_add_favorite"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/queueSelectionFavoriteIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/player_ic_heart_outline" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/queueSelectionRemove"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/player_cell_bg"
                        android:clickable="true"
                        android:contentDescription="@string/queue_remove"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/player_ic_delete"
                            android:tint="#ECEFF1" />
                    </FrameLayout>
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/queueList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingTop="4dp"
                        android:paddingBottom="8dp" />

                    <TextView
                        android:id="@+id/queueEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:padding="24dp"
                        android:text="@string/queue_empty"
                        android:textColor="@color/text_muted"
                        android:textSize="15sp"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- Inline synchronized/embedded lyrics stage -->
            <FrameLayout
                android:id="@+id/playerLyricsStage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0"
                android:paddingTop="56dp"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/lyricsList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp" />

                <TextView
                    android:id="@+id/lyricsEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/lyrics_empty"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/playerClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_margin="6dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/player_close"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_down"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.54"
            android:clipChildren="false"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingEnd="6dp">

                <!-- Sleep timer countdown, only while a timer runs -->
                <TextView
                    android:id="@+id/playerSleepChip"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="18dp"
                    android:background="@drawable/player_chip_bg"
                    android:clickable="true"
                    android:drawableStart="@drawable/player_ic_sleep"
                    android:drawablePadding="6dp"
                    android:drawableTint="#FFFFFF"
                    android:focusable="true"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/playerMore"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="@drawable/player_cell_bg"
                    android:clickable="true"
                    android:contentDescription="@string/menu_more"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/playerMoreIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/player_ic_more"
                        android:tint="#FFFFFF" />
                </FrameLayout>
            </FrameLayout>

            <!-- Fades and slides as one unit on track changes -->
            <LinearLayout
                android:id="@+id/playerTextBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="24dp"
                android:paddingRight="24dp">

                <me.Integer.Mediaplayer.ui.widgets.MarqueeTextView
                    android:id="@+id/playerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/playerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:singleLine="true"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include
                layout="@layout/player_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
