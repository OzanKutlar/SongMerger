<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:animateLayoutChanges="true"
    android:orientation="vertical">

    <!-- Header: title, search, menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/librarySearchButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/library_search"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_search"
                android:tint="#F5F5F7" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/libraryMoreButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/library_more"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_more"
                android:tint="#F5F5F7" />
        </FrameLayout>
    </LinearLayout>

    <!-- Search bar, opened from the header -->
    <LinearLayout
        android:id="@+id/librarySearchBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/player_search_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/player_ic_search"
            android:tint="#6E6E73" />

        <EditText
            android:id="@+id/librarySearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/library_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <FrameLayout
            android:id="@+id/librarySearchClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/library_search_close"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_close"
                android:tint="#A1A1A6" />
        </FrameLayout>
    </LinearLayout>

    <!-- Tabs: sizes and colours are animated in code -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/libraryTabSongs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/library_tab_songs"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/libraryTabFavorites"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/library_tab_favorites"
            android:textColor="@color/text_muted"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/libraryTabArtists"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="@string/library_tab_artists"
            android:textColor="@color/text_muted"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- The list card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/player_card_bg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:id="@+id/librarySort"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/library_sort"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:id="@+id/librarySortIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_sort"
                    android:tint="#A1A1A6" />

                <TextView
                    android:id="@+id/librarySortLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#C7C7CC"
                    android:textSize="16sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/libraryShuffle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/player_round_button_bg"
                android:clickable="true"
                android:contentDescription="@string/library_shuffle_all"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_shuffle"
                    android:tint="#F5F5F7" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/libraryPlayAll"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_round_button_bg"
                android:clickable="true"
                android:contentDescription="@string/library_play_all"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_play"
                    android:tint="#F5F5F7" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/libraryScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="6dp"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/libraryList"
                android:layoutAnimation="@anim/list_cascade"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="96dp" />

            <TextView
                android:id="@+id/libraryEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="32dp"
                android:textColor="@color/text_muted"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
