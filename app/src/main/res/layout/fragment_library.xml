<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp">

        <EditText
            android:id="@+id/librarySearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/library_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/librarySettings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/library_settings"
            android:textColor="@color/accent"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/libraryTabSongs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/library_tab_songs"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/libraryTabArtists"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/library_tab_artists"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/libraryScan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/libraryList"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/libraryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Mini player: tap to open the full player -->
    <LinearLayout
        android:id="@+id/miniBar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:background="@color/surface"
        android:clickable="true"
        android:contentDescription="@string/player_open"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:visibility="gone">

        <me.Integer.Mediaplayer.ui.widgets.VinylDiscView
            android:id="@+id/miniVinyl"
            android:layout_width="52dp"
            android:layout_height="52dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <me.Integer.Mediaplayer.ui.widgets.MarqueeTextView
                android:id="@+id/miniTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/miniPlay"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_play"
            android:focusable="true">

            <ImageView
                android:id="@+id/miniPlayIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_play"
                android:tint="#ECEFF1" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/miniNext"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_next"
            android:focusable="true">

            <ImageView
                android:id="@+id/miniNextIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_next"
                android:tint="#ECEFF1" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
