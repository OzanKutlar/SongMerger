<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/queueHeader"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <FrameLayout
            android:id="@+id/queueBack"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/settings_back"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_back"
                android:tint="#F5F5F7" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/queue_title"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queueSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/queueShuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_round_button_bg"
            android:clickable="true"
            android:contentDescription="@string/player_shuffle"
            android:focusable="true">

            <ImageView
                android:id="@+id/queueShuffleIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_shuffle"
                android:tint="#ECEFF1" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/queueMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_round_button_bg"
            android:clickable="true"
            android:contentDescription="@string/queue_more"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_more"
                android:tint="#ECEFF1" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/queueSelectionBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/queueSelectionClose"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/queue_selection_close"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_close"
                android:tint="#F5F5F7" />
        </FrameLayout>

        <TextView
            android:id="@+id/queueSelectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/queueSelectAll"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/queue_select_all"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_select_all"
                android:tint="#ECEFF1" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/queueSelectionPlaylist"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/menu_add_playlist"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_add"
                android:tint="#ECEFF1" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/queueSelectionFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/menu_add_favorite"
            android:focusable="true">

            <ImageView
                android:id="@+id/queueSelectionFavoriteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_heart_outline" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/queueSelectionRemove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/queue_remove"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_delete"
                android:tint="#ECEFF1" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/player_card_bg">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/queueList"
            android:layoutAnimation="@anim/list_cascade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/queueEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/queue_empty"
            android:textColor="@color/text_muted"
            android:textSize="16sp"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
