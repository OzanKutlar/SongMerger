<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <FrameLayout
        android:id="@+id/playlistRowThumb"
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:background="@drawable/grid_tile_bg"
        android:foreground="?attr/selectableItemBackground">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/player_ic_queue"
            android:tint="#6E6E73" />

        <ImageView
            android:id="@+id/playlistRowArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:id="@+id/playlistRowMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/menu_more"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_more"
                android:tint="#E6F5F5F7" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/grid_tile_scrim"
            android:gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="22dp"
            android:paddingEnd="8dp"
            android:paddingBottom="7dp">

            <TextView
                android:id="@+id/playlistRowName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/playlistRowCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
