<?xml version="1.0" encoding="utf-8"?>
<!-- Actions, seek bar and transport controls; shared by both orientations. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <!-- Queue, Favorite and Add to playlist, just above the seek bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <FrameLayout
            android:id="@+id/playerQueue"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_queue"
            android:focusable="true">

            <ImageView
                android:id="@+id/playerQueueIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_queue"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/playerFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_favorite"
            android:focusable="true">

            <ImageView
                android:id="@+id/playerFavoriteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_heart_outline"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/playerAdd"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_add_playlist"
            android:focusable="true">

            <ImageView
                android:id="@+id/playerAddIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_add"
                android:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/playerSeek"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/player_seek"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:progressDrawable="@drawable/player_seek_progress"
        android:splitTrack="false"
        android:thumb="@drawable/player_seek_thumb" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <TextView
            android:id="@+id/playerElapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/playerDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Every cell is a full touch target; the icons themselves stay small -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="10dp"
        android:clipChildren="false"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <FrameLayout
            android:id="@+id/playerShuffle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_shuffle"
            android:focusable="true">

            <ImageView
                android:id="@+id/playerShuffleIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_shuffle" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/playerPrevious"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_previous"
            android:focusable="true">

            <ImageView
                android:id="@+id/playerPreviousIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_previous"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/playerPlay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:clipChildren="false"
            android:contentDescription="@string/player_play"
            android:focusable="true">

            <!-- Press feedback scales this frame; the icon inside morphs on its own -->
            <FrameLayout
                android:id="@+id/playerPlayButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/playerPlayIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/player_ic_play"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/playerNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_next"
            android:focusable="true">

            <ImageView
                android:id="@+id/playerNextIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_next"
                android:tint="#FFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/playerRepeat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/player_cell_bg"
            android:clickable="true"
            android:contentDescription="@string/player_repeat"
            android:focusable="true">

            <ImageView
                android:id="@+id/playerRepeatIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/player_ic_repeat" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
