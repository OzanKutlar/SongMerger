<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait player: top bar, record in the middle, text and controls below -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true">

    <me.Integer.Mediaplayer.ui.widgets.CoverAmbienceView
        android:id="@+id/playerAmbience"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- Top bar: Close on the left, Favorite / Queue / More on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <FrameLayout
                android:id="@+id/playerClose"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/player_close"
                android:focusable="true">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_down"
                    android:tint="#FDF8F5" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/playerFavorite"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/player_favorite"
                android:focusable="true">

                <ImageView
                    android:id="@+id/playerFavoriteIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_heart_outline"
                    android:tint="#FDF8F5" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/playerQueue"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/player_queue"
                android:focusable="true">

                <ImageView
                    android:id="@+id/playerQueueIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_queue"
                    android:tint="#FDF8F5" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/playerMore"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/menu_more"
                android:focusable="true">

                <ImageView
                    android:id="@+id/playerMoreIcon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_more"
                    android:tint="#FDF8F5" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="28dp"
            android:paddingTop="8dp"
            android:paddingRight="28dp"
            android:paddingBottom="20dp">

            <me.Integer.Mediaplayer.ui.widgets.VinylDiscView
                android:id="@+id/playerVinyl"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:clickable="true"
                android:contentDescription="@string/player_cover"
                android:focusable="true" />
        </FrameLayout>

        <include
            layout="@layout/player_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</FrameLayout>
