<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait player: record near the top with the title under it, controls at the bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clickable="true">

    <me.Integer.Mediaplayer.ui.widgets.CoverAmbienceView
        android:id="@+id/playerAmbience"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- Top bar: Close on the left, More on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <FrameLayout
                android:id="@+id/playerClose"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/player_close"
                android:focusable="true">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_down"
                    android:tint="#FFFFFF" />
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/playerMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_cell_bg"
                android:clickable="true"
                android:contentDescription="@string/menu_more"
                android:focusable="true">

                <ImageView
                    android:id="@+id/playerMoreIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/player_ic_more"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!--
            The record is as big as the width allows and sits at the top, the title right
            under it. Height the record cannot use stays empty above the controls; on short
            screens the record shrinks instead.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingTop="4dp">

            <me.Integer.Mediaplayer.ui.widgets.VinylDiscView
                android:id="@+id/playerVinyl"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginLeft="28dp"
                android:layout_marginRight="28dp"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="@string/player_cover"
                android:focusable="true" />

            <!-- Fades and slides as one unit on track changes -->
            <LinearLayout
                android:id="@+id/playerTextBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingLeft="28dp"
                android:paddingRight="28dp">

                <me.Integer.Mediaplayer.ui.widgets.MarqueeTextView
                    android:id="@+id/playerTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_horizontal"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/playerArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:gravity="center_horizontal"
                    android:singleLine="true"
                    android:textColor="#CCFFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <include
            layout="@layout/player_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</FrameLayout>
