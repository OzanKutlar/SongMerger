<?xml version="1.0" encoding="utf-8"?>
<!-- Orange-tinted pill for background job status in the library. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FF6D00">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FFF6D00" />
            <stroke
                android:width="1dp"
                android:color="#66FF6D00" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</ripple>
