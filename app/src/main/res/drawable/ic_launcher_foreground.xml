        android:strokeWidth="1.0" />

    <!-- Sleek trailing motion/equalizer bar on the left -->
    <path
        android:pathData="M41.5,45.5L41.5,62.5"
        android:strokeColor="#CCFF9E40"
        android:strokeLineCap="round"
        android:strokeWidth="3.4" />

