    <path android:pathData="M47.5,42.8C47.5,41.1 49.35,40.05 50.82,40.92L66.4,50.12C67.84,50.97 67.84,53.03 66.4,53.88L50.82,63.08C49.35,63.95 47.5,62.9 47.5,61.2Z">
