        android:fillColor="#36000000"
        android:pathData="M40,31h28a13,13 0,0 1,13 13v28a13,13 0,0 1,-13 13h-28a13,13 0,0 1,-13 -13v-28a13,13 0,0 1,13 -13z" />

    <!-- Outer sleek box body with warm obsidian-orange gradient -->
    <path android:pathData="M40,28h28a12,12 0,0 1,12 12v28a12,12 0,0 1,-12 12h-28a12,12 0,0 1,-12 -12v-28a12,12 0,0 1,12 -12z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="28"
                android:startY="28"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2B1912" />
                <item android:offset="0.55" android:color="#FF19100D" />
                <item android:offset="1.0" android:color="#FF0E0908" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30"
                android:startY="28"
                android:endX="78"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#B3FFF3E0" />
                <item android:offset="0.5" android:color="#66FF9100" />
                <item android:offset="1.0" android:color="#33FF3D00" />
            </gradient>
        </aapt:attr>
        <android:attr name="android:strokeWidth">1.6</android:attr>
    </path>

    <!-- Top-half glass highlight inside the box -->
    <path android:pathData="M40,29.5h28a10.5,10.5 0,0 1,10.5 10.5v11C66,55 42,55 29.5,51v-11a10.5,10.5 0,0 1,10.5 -10.5z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="29"
                android:endX="54"
                android:endY="55"
                android:type="linear">
                <item android:offset="0.0" android:color="#2EFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner glowing orange accent frame -->
    <path
        android:pathData="M41.5,33h25a8.5,8.5 0,0 1,8.5 8.5v25a8.5,8.5 0,0 1,-8.5 8.5h-25a8.5,8.5 0,0 1,-8.5 -8.5v-25a8.5,8.5 0,0 1,8.5 -8.5z"
