<?xml version="1.0" encoding="utf-8"?>
<!-- A dark vinyl record with an orange label, like the record in the player. Fits the safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft shadow under the record -->
    <path
        android:fillColor="#59000000"
        android:pathData="M54,29.5a27,27 0,1 1,0 54a27,27 0,1 1,0 -54z" />

    <!-- Record body -->
    <path android:pathData="M54,28a26,26 0,1 1,0 52a26,26 0,1 1,0 -52z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="26"
                android:type="radial">
                <item android:offset="0.0" android:color="#FF2A1E1C" />
                <item android:offset="0.7" android:color="#FF120C0C" />
                <item android:offset="1.0" android:color="#FF070506" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Grooves -->
    <path
        android:pathData="M54,32a22,22 0,1 1,0 44a22,22 0,1 1,0 -44z"
        android:strokeColor="#1FFFFFFF"
        android:strokeWidth="0.6" />
    <path
        android:pathData="M54,35.5a18.5,18.5 0,1 1,0 37a18.5,18.5 0,1 1,0 -37z"
        android:strokeColor="#1AFFFFFF"
        android:strokeWidth="0.6" />
    <path
        android:pathData="M54,39a15,15 0,1 1,0 30a15,15 0,1 1,0 -30z"
        android:strokeColor="#14FFFFFF"
        android:strokeWidth="0.6" />

    <!-- Shine on the upper left -->
    <path
        android:pathData="M36.68,44A20,20 0,0 1,47.16 35.21"
        android:strokeColor="#4DFFFFFF"
        android:strokeLineCap="round"
        android:strokeWidth="1.6" />

    <!-- Orange accent arc on the right, as on the player's record -->
    <path
        android:pathData="M72,38.89A23.5,23.5 0,0 1,72 69.11"
        android:strokeColor="#FFFF6D00"
        android:strokeLineCap="round"
        android:strokeWidth="2.2" />

    <!-- Rim -->
    <path
        android:pathData="M54,28a26,26 0,1 1,0 52a26,26 0,1 1,0 -52z"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="0.8" />

    <!-- Label -->
    <path android:pathData="M54,45a9,9 0,1 1,0 18a9,9 0,1 1,0 -18z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="47"
                android:startY="46"
                android:endX="61"
                android:endY="62"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFA94D" />
                <item android:offset="0.55" android:color="#FFFF6D00" />
                <item android:offset="1.0" android:color="#FFC93A06" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Spindle hole -->
    <path
        android:fillColor="#FF0B090B"
        android:pathData="M54,52.2a1.8,1.8 0,1 1,0 3.6a1.8,1.8 0,1 1,0 -3.6z" />
</vector>
