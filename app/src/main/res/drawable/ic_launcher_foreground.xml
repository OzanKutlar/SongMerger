            <gradient
                android:startX="47.5"
                android:startY="40"
                android:endX="67.5"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.65" android:color="#FFFFF3E0" />
                <item android:offset="1.0" android:color="#FFFFCC80" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
