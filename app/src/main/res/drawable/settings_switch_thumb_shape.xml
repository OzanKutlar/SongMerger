<?xml version="1.0" encoding="utf-8"?>
<!-- Round thumb sitting 4dp inside the 28dp track; its color comes from @color/settings_switch_thumb. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="4dp">
    <shape android:shape="oval">
        <solid android:color="#FFFFFFFF" />
        <size
            android:width="20dp"
            android:height="20dp" />
    </shape>
</inset>
