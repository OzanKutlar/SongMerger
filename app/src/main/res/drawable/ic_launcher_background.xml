<?xml version="1.0" encoding="utf-8"?>
<!-- Near-black, with the player's warm glow rising from the bottom. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF0B090B"
        android:pathData="M0,0h108v108h-108z" />

    <!-- Faint plum light in the lower left -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="18"
                android:centerY="112"
                android:gradientRadius="56"
                android:type="radial">
                <item android:offset="0.0" android:color="#7A6A1E48" />
                <item android:offset="0.55" android:color="#2A3A1030" />
                <item android:offset="1.0" android:color="#000B090B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Warm ember glow from the bottom centre -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="62"
                android:centerY="120"
                android:gradientRadius="74"
                android:type="radial">
                <item android:offset="0.0" android:color="#C2E2600A" />
                <item android:offset="0.42" android:color="#5C8A2C0A" />
                <item android:offset="1.0" android:color="#000B090B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
